{
  "schema_version": 1,
  "site": "jlc.com",
  "unit": "mm",
  "description": "嘉立创PCB制板工艺规范库（国内站）。所有数值判定只读此文件；脚本内禁止出现裸阈值。limit=官方极限/最低可行(低于则BLOCK)；recommended=官方建议/EDA预设(低于则WARN)；cost_trigger=官方标注非常规/费用高。",
  "tolerance_epsilon": 0.001,
  "sources": {
    "S_PCB": {
      "tier": "T1",
      "title": "嘉立创PCB工艺加工能力范围说明",
      "url": "https://www.jlc.com/portal/vtechnology.html",
      "fetched_at": "2026-10-30"
    },
    "S_PRESET": {
      "tier": "T0",
      "title": "嘉立创EDA专业版客户端内置预设规则 JLCPCB Capability(...)",
      "url": "eda.pcb_Drc.getAllRuleConfigurations(true)",
      "fetched_at": "2026-10-30",
      "note": "客户端 v4.1.93 实测读取，原始快照见 data/rule-presets/_all_raw.json"
    }
  },
  "rules": [
    {
      "id": "PCB.TRACE.WIDTH_MIN",
      "name": "最小线宽",
      "key": "min_track_width",
      "op": ">=",
      "limit": {
        "by": {
          "single_1oz": 0.1,
          "double_1oz": 0.1,
          "multi_1oz": 0.0889,
          "double_2oz": 0.16,
          "multi_2oz": 0.15,
          "double_2.5oz": 0.2,
          "double_3.5oz": 0.25,
          "double_4.5oz": 0.3
        },
        "src": "S_PCB",
        "quote": "最小线宽/线距（1oz）单双面板：0.10/0.10mm(4mil/4mil) 多层板：0.09/0.09mm(3.5mil/3.5mil)；2oz 双面板6.5mil 多层板6mil；2.5oz 8mil；3.5oz 10mil；4.5oz 12mil",
        "rounding_note": "官方同一行同时印 mm 与 mil（如 0.10mm / 4mil=0.1016mm，四舍五入不一致）。取较小者作为 limit，避免对 0.10mm 等常用合规线宽误判 BLOCK。多层1oz 官方印 0.09mm/3.5mil(=0.0889)，取 0.0889。"
      },
      "recommended": {
        "by": {
          "single_1oz": 0.102,
          "double_1oz": 0.127,
          "multi_1oz": 0.102,
          "single_2oz": 0.203,
          "double_2oz": 0.203,
          "multi_2oz": 0.203
        },
        "src": "S_PRESET",
        "quote": "Physics.Track.copperThickness1oz/2oz.form.strokeWidthMin（Single/Two/Multiple Layers Board 预设）"
      },
      "note": "线宽公差 ±20%（官方）"
    },
    {
      "id": "PCB.TRACE.SPACE_MIN",
      "name": "最小线距",
      "key": "min_track_space",
      "op": ">=",
      "limit": {
        "by": {
          "single_1oz": 0.1,
          "double_1oz": 0.1,
          "multi_1oz": 0.0889,
          "double_2oz": 0.16,
          "multi_2oz": 0.15,
          "double_2.5oz": 0.2,
          "double_3.5oz": 0.25,
          "double_4.5oz": 0.3
        },
        "src": "S_PCB",
        "quote": "最小线宽/线距 同一行给出等值（如 0.10/0.10mm）",
        "rounding_note": "官方同一行同时印 mm 与 mil（如 0.10mm / 4mil=0.1016mm，四舍五入不一致）。取较小者作为 limit，避免对 0.10mm 等常用合规线宽误判 BLOCK。多层1oz 官方印 0.09mm/3.5mil(=0.0889)，取 0.0889。"
      },
      "recommended": {
        "by": {
          "default_1oz": 0.102,
          "default_2oz": 0.203
        },
        "src": "S_PRESET",
        "quote": "Spacing.Safe Spacing.copperThickness1oz/2oz.table[Track-Track]（三套预设一致）"
      }
    },
    {
      "id": "PCB.DRILL.PLATED_MIN",
      "name": "最小金属化孔径(含过孔)",
      "key": "min_plated_drill",
      "op": ">=",
      "limit": {
        "by": {
          "single": 0.3,
          "double": 0.15,
          "multi": 0.15
        },
        "src": "S_PCB",
        "quote": "钻孔孔径 单面板：0.3~6.3mm 双面板：0.15~6.3mm 多层板：0.15~6.3mm"
      },
      "recommended": {
        "by": {
          "single": 0.3,
          "double": 0.3,
          "multi": 0.2
        },
        "src": "S_PRESET",
        "quote": "Physics.Via Size.viaSize.form.viaInnerdiameterMin（单层0.3/双层0.3/多层0.2）；官方另注：最小孔推荐0.2mm以上"
      },
      "cost_trigger": {
        "below": 0.2,
        "src": "S_PCB",
        "quote": "双面板、多层板最小钻孔0.15mm（非常规！费用高请慎用）"
      }
    },
    {
      "id": "PCB.VIA.OUTER_MIN",
      "name": "最小过孔外径",
      "key": "min_via_outer",
      "op": ">=",
      "limit": {
        "by": {
          "single": 0.5,
          "double": 0.25,
          "multi": 0.25
        },
        "src": "S_PCB",
        "quote": "最小过孔/焊盘 单面板：0.3mm(内径)/0.5mm(外径) 双面板、多层板：0.15mm(内径)/0.25mm(外径)"
      },
      "recommended": {
        "by": {
          "single": 0.5,
          "double": 0.5,
          "multi": 0.3
        },
        "src": "S_PRESET",
        "quote": "Physics.Via Size.viaSize.form.viaOuterdiameterMin（单层0.5/双层0.5/多层0.3）"
      }
    },
    {
      "id": "PCB.VIA.RING_MIN",
      "name": "过孔外径比内径大",
      "key": "min_via_outer_minus_drill",
      "op": ">=",
      "limit": {
        "value": 0.1,
        "src": "S_PCB",
        "quote": "① 外径必须比内径大0.1mm,推荐大0.15mm以上"
      },
      "recommended": {
        "value": 0.15,
        "src": "S_PCB",
        "quote": "① 外径必须比内径大0.1mm,推荐大0.15mm以上"
      }
    },
    {
      "id": "PCB.VIA.HOLE_EDGE_GAP",
